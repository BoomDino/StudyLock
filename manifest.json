{
  "manifest_version": 3,
  "name": "StudyLock",
  "version": "1.1.0",
  "description": "Earn a configurable, timed Crunchyroll reward by reporting your study time.",
  "permissions": [
    "storage",
    "alarms",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://*.crunchyroll.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.crunchyroll.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "StudyLock",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
